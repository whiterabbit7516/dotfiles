{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git add:*)"
    ],
    "defaultMode": "auto"
  },
  "outputStyle": "default",
  "effortLevel": "medium",
  "theme": "dark",
  "editorMode": "vim",
  "preferredNotifChannel": "terminal_bell"
}
